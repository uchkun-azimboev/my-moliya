# Bu faylni nusxalab .env.local deb nomlang va qiymatlarni o'zingiz qo'ying.
# .env.local hech qachon GitHub'ga yuklanmaydi (.gitignore da).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# "anon public" kaliti yoki yangi "publishable" kaliti (sb_publishable_...) — ikkalasi ham ishlaydi
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# DIQQAT: service_role / secret kalitini bu yerga ham, boshqa joyga ham QO'YMANG.
